<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>KeyboardWorker</AssemblyName>
    <Version>2.2.0</Version>
    <!-- Where the "업데이트 확인" button looks for new versions: owner/repository on GitHub (public). Leave empty for no update address.
         To publish an update: raise Version above, run tools\make-dist.ps1, and attach dist\KeyboardWorker-win-x64.zip to a GitHub release tagged v<Version>. -->
    <UpdateRepository>cyan83258/keyboard-worker</UpdateRepository>
    <Product>Keyboard Worker</Product>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ApplicationIcon Condition="Exists('Assets\pet.ico')">Assets\pet.ico</ApplicationIcon>
    <!-- Sources live in Core, Pet, Ai, Model, Windows and SelfCheck. These folders are not part of the program:
         app = the copy that is actually run, dist = the package for other people, tests = the test project,
         tools = build scripts, installer = the small setup program (its own project). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);app\**;dist\**;tests\**;tools\**;installer\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup><InternalsVisibleTo Include="KeyboardWorker.Tests" /></ItemGroup>
  <ItemGroup><AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" /></ItemGroup>
  <!-- Backgrounds that come with the program: every PNG / JPG under Assets\Backgrounds is copied to "backgrounds" next to it.
       The file name is the title the AI chooses by (street_night.jpg -> "street night"); a subfolder is a group. -->
  <ItemGroup><Content Include="Assets\Backgrounds\**\*.png;Assets\Backgrounds\**\*.jpg;Assets\Backgrounds\**\*.jpeg" Link="backgrounds\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <!-- Accessories that come with the program and are sold in the shop: every PNG / JPG under Assets\Accessories (and accessories.json,
       which places them) is copied to "accessories" next to it. See Model\ShopGear.cs for the file names and the list. -->
  <ItemGroup><Content Include="Assets\Accessories\*.png;Assets\Accessories\*.jpg;Assets\Accessories\*.jpeg;Assets\Accessories\*.json" Link="accessories\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <!-- The typeface the novel is read in: Assets\Fonts is copied to "fonts" next to the program. -->
  <ItemGroup><Content Include="Assets\Fonts\*.otf;Assets\Fonts\*.ttf" Link="fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets\pet.ico" LogicalName="KeyboardWorker.pet.ico" Condition="Exists('Assets\pet.ico')" /></ItemGroup>
</Project>
